#include<bits/stdc++.h>
#define task "main"
//#include <ext/pb_ds/assoc_container.hpp>
//#include <ext/pb_ds/tree_policy.hpp>
#define endl '\n'
#define int long long
#define pb push_back
#define fi first
#define se second
#define ii pair<int,int>
#define iii pair<int,ii>
#define iv pair<ii, ii>
#define base 341
#define MASK(i) (1ll << i)
#define oo 1e18
#define isOn(x,i) ((x) & MASK(i))
#define bitOn(x,i) ((x) | MASK(i))
#define bitOff(x,i) ((x) & ~MASK(i))
#define ordered_set tree<int, null_type,less<int>, rb_tree_tag,tree_order_statistics_node_update>
#define __lcm(a,b) (1ll * ((a) / __gcd((a), (b))) * (b))
using namespace std;
//using namespace __gnu_pbds;
const int maxn = 1e6 + 5;

int n, x, y, m[maxn], mod = 1e9 + 7;

int mul(int a, int b) {
    return ((a % mod) * (b % mod)) % mod;
}

int f[maxn];
int iFact[maxn];
int fastPow(int a, int k) {
	int res = 1;
	while (k) {
        if (k & 1) {
            res = 1ll * res * a % mod;
        }
        a = 1ll * a * a % mod;
        k >>= 1;
    }
    return res;
}
int a,b,c,d;
int C(int k, int n) {
    if (k > n || k < 0) return 0;
    return 1ll * (1ll * f[n] * iFact[k] % mod) * iFact[n - k] % mod;
}

main() {
    ios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0);
    if(fopen(task".inp","r")) {
        freopen(task".inp","r",stdin);
        freopen(task".out","w",stdout);
    }
    if (!(cin >> n >> x >> y)) return 0;

    f[0] = 1;
    for (int i = 1; i <= n; i++) {
        f[i] = f[i-1]*i%mod;
    }
    iFact[n] = fastPow(f[n], mod - 2);
    for (int i = n-1; i >= 0; i--) {
        iFact[i] = iFact[i + 1] * (i + 1) % mod;
    }

    for (int i = 1; i <= n; i++) cin >> m[i];

    int ans = 1;
    for (int bit = 0; bit <= 30; bit++) {
        int t1 = (x >> bit) & 1, t2 = (y >> bit) & 1;

        int cnt = 0;
        for (int i = 1; i <= n; i++) {
            if (isOn(m[i], bit)) cnt++;
        }

        int tmp = n - cnt, res = 0;
        for (int k = 0; k <= tmp; k++) {
            // Kiểm tra tính chẵn lẻ cho điều kiện XOR
            if ((cnt + k) % 2 != t2) continue;

            // Kiểm tra điều kiện OR
            if (t1 == 1) {
                // OR = 1: ít nhất 1 phần tử phải có bit này là 1
                if (cnt == 0 && k == 0) continue;
            }
            else {
                // OR = 0: tất cả phần tử phải có bit này là 0
                if (!(cnt == 0 && k == 0)) continue;
            }
            res = (res + C(k, tmp)) % mod;
        }
        ans = mul(ans, res);
    }
    cout << ans;
    return 0;
}
