#include<bits/stdc++.h>
using namespace std;
#define ll long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define debug(x) cout<< #x << " = "<< x <<'\n'
#define Task "a"
#define ii pair<int,int>
#define iii pair<int,ii>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const ll inf=1e18;
const ll N=2e5+5;
const ll mod=1e9+7;
const ll base=311;
const ll phainon=33550336;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask&~(1LL<<i))
inline ll add(ll a,ll b){
    ll res=a+b;
    if(res>=mod) res-=mod;
    return res;
}
ll sub(ll a,ll b){
    return ((a-b)%mod+mod)%mod;
}
inline ll mul(ll a,ll b){
    ll res=a*b;
    if(res>=mod) res%=mod;
    return res;
}
const int MAXN = 2000005; // >= n + số union
int p[MAXN];
long long val[MAXN], lazy[MAXN];
int tot; // tổng số node (ban đầu = n)

/* find + lazy propagation */
int acs(int u) {
    if (p[u] == u) return u;
    int par = acs(p[u]);

    // đẩy lazy từ cha xuống u trước khi nén
    val[u] += lazy[p[u]];
    lazy[u] += lazy[p[u]];

    return p[u] = par;
}

/* cộng x cho cả component chứa u */
void add(int u, long long x) {
    u = acs(u);
    val[u] += x;
    lazy[u] += x;
}

/* lấy giá trị hiện tại của u */
long long getVal(int u) {
    acs(u);
    return val[u];
}

/* union bằng node trung gian */
void join(int u, int v) {
    int pu = acs(u);
    int pv = acs(v);
    if (pu == pv) return;

    int w = ++tot;
    p[w] = w;
    val[w] = 0;
    lazy[w] = 0;

    p[pu] = w;
    p[pv] = w;
}
int n;
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    if (fopen(Task ".inp","r")) {
        freopen(Task ".inp","r", stdin);
        freopen(Task ".out","w", stdout);
    }
    cin>>n;
    for(int i=1;i<=n;i++){
        p[i]=i;
        tot++;
    }
    add(1,3);
    cout<<getVal(1)<<'\n';
    join(1,2);
    cout<<getVal(2)<<'\n';
    add(1,5);
    cout<<getVal(1)<<" "<<getVal(2)<<'\n';
}
