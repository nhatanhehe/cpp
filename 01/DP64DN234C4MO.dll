#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i))
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return ((a%mod+b%mod)%mod+mod)%mod;
}
int n,k,a[N],l=1,r=0,ans,dp_before[N],dp_cur[N],cnt[N];
int F(int n){
    return n*(n-1)/2;
}
int C(int newl,int newr){
    while(l>newl){
        l--;
        ans-=F(cnt[a[l]]);
        cnt[a[l]]++;
        ans+=F(cnt[a[l]]);
    }
    while(r<newr){
        r++;
        ans-=F(cnt[a[r]]);
        cnt[a[r]]++;
        ans+=F(cnt[a[r]]);
    }
    while(l<newl){
        ans-=F(cnt[a[l]]);
        cnt[a[l]]--;
        ans+=F(cnt[a[l]]);
        l++;
    }
    while(r>newr){
        ans-=F(cnt[a[r]]);
        cnt[a[r]]--;
        ans+=F(cnt[a[r]]);
        r--;
    }
    return ans;
}
void dnc(int l,int r,int optl,int optr){
    if(l>r) return;
    int mid=(l+r)>>1;
    ii best={inf,-1};
    for(int i=optl;i<=min(optr,mid);i++){
        best=min(best,{dp_before[i]+C(i+1,mid),i});
    }
    int opt=best.se;
    dp_cur[mid]=best.fi;
    dnc(l,mid-1,optl,opt);
    dnc(mid+1,r,opt,optr);
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n>>k;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    for(int i=1;i<=n;i++){
        dp_before[i]=inf;
    }
    for(int i=1;i<=k;i++){
        dnc(0,n,0,n);
        for(int j=0;j<=n;j++){
            dp_before[j]=dp_cur[j];
        }
    }
    cout<<dp_cur[n];
}
