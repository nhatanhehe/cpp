/*
1 l r:sum(a[i]).
2 l r x: a[i]=a[i] mod x.
3 k x:a[k]=x;
*/
#include <bits/stdc++.h>
using namespace std;
#define task "segbeatmod"
#define int long long
#define ll long long
#define ii pair<int,int>
#define iii pair<int,ii>
#define fi first
#define se second
#define vi vector<int>
#define vii vector<ii>
#define pb push_back

const int N=2e5+9;
int n,m,a[N];
struct Node{
    //sửa tham số seg merge ở đây, nhớ cho tham số đầu vào.
    int mx=0;
    int sum=0;
    bool operator==(const Node& other) const {
        return (mx == other.mx && sum==other.sum);
    }
};
Node oo={0,0};
template <typename T>
struct SegmentTree {
    int n;
    vector<T> tree;
    T neutral;

    //sửa combine ở đây
    T Merge(const T& a, const T& b) {
        T res;
        res.mx=max(a.mx,b.mx);
        res.sum=a.sum+b.sum;
        return res;
    }

    SegmentTree(int _n, T _neutral) {
        n = _n;
        neutral = _neutral;
        tree.assign(4 * n + 9, neutral);
    }

    void build(int i, int u, int v) {
        if (u == v) {
            //sửa đoạn build ở đây .
            tree[i].mx = a[u];
            tree[i].sum= a[u];
        } else {
            int mid = (u + v) / 2;
            build(2 * i, u, mid);
            build(2 * i + 1, mid + 1, v);
            tree[i] = Merge(tree[2 * i], tree[2 * i + 1]);
        }
    }

    void update1(int i, int u, int v, int idx, int val) {
        if (u == v) {
            //sửa update ở đây
            tree[i].mx=val;
            tree[i].sum=val;
        } else {
            int mid = (u + v) / 2;
            if (u <= idx && idx <= mid) {
                update1(2 * i, u, mid, idx, val);
            } else {
                update1(2 * i + 1, mid + 1, v, idx, val);
            }
            tree[i] = Merge(tree[2 * i], tree[2 * i + 1]);
        }
    }

    void update(int i,int l,int r,int u,int v,int val){
        if(l>v || r<u) return;
        if(l<=u && v<=r && tree[i].mx<val){
            return;
        }
        if(u==v){
            int lp=tree[i].sum;
            tree[i].mx=lp%val;
            tree[i].sum=lp%val;
            return;
        }
        update(i*2,l,r,u,(u+v)/2,val);
        update(i*2+1,l,r,(u+v)/2+1,v,val);

        tree[i]=Merge(tree[i*2],tree[i*2+1]);
    }
    int  query(int i, int u, int v, int l, int r) {
        if (r < u || v < l) {
            return 0;
        }
        if (l <= u && v <= r) {
            return tree[i].sum;
        }

        int mid = (u + v) / 2;
        int p1 = query(2 * i, u, mid, l, r);
        int p2 = query(2 * i + 1, mid + 1, v, l, r);

//        if (p1 == neutral) return p2;
//        if (p2 == neutral) return p1;

        return p1+p2;
    }

    void update1(int pos, int val) {
        update1(1, 1, n, pos, val);
    }

    void update(int l,int r,int val){
        update(1,l,r,1,n,val);
    }
    int  get(int l, int r) {
        return query(1, 1, n, l, r);
    }
};

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);cout.tie(0);

//    freopen(task".inp","r",stdin);
//    freopen(task".out","w",stdout);

    cin>>n>>m;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    SegmentTree<Node> st(n,oo);
    st.build(1,1,n);
    for(int i=1;i<=m;i++){
        int ty;
        cin>>ty;
        if(ty==1){
            int l,r;
            cin>>l>>r;
            cout<<st.get(l,r)<<"\n";
        }
        else
        if(ty==2){
            int l,r,x;
            cin>>l>>r>>x;
            st.update(l,r,x);
        }
        else
        if(ty==3){
            int k,x;
            cin>>k>>x;
            st.update1(k,x);
        }
    }
}
