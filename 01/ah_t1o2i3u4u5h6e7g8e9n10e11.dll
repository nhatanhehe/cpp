#include<bits/stdc++.h>
#define task "main"
//#define int long long
#define endl '\n'
#define pb push_back
#define fi first
#define se second
#define ii pair<int,int>
#define iii pair<int,ii>
#define iv pair<ii, ii>
#define base 341
#define MASK(i) (1ll << i)
#define oo 2e9
#define isOn(x,i) ((x) & MASK(i))
#define bitOn(x,i) ((x) | MASK(i))
#define bitOff(x,i) ((x) & ~MASK(i))
using namespace std;
const int maxn = 2e5 + 5;

int n, m, k, a[maxn], b[maxn];
vector <int> v[maxn];

namespace giai2{
    int cnt[102], last[102];
    bool ss(int x, int y) {
        return last[x] > last[y];
    }

    void solve() {
        long long ans = 0;
        for (int i = 1; i <= n; i++) {
            for (int x : v[i]) last[x] = i;
            vector <int> v;
            for (int x = 1; x <= m; x++) {
                if (last[x] != 0)
                    v.pb(x);
            }
            sort(v.begin(), v.end(), [&](const int &x,const int &y){
                return last[x]>last[y];
            });
            long long cost = 0, val = 0;
            int idx = 0;
            while(idx < (int)v.size()) {
                int pos = last[v[idx]];
                while(idx < (int)v.size() && last[v[idx]] == pos) {
                    int x = v[idx];
                    val += a[x];
                    cost += b[x];
                    idx++;
                }
                if (cost <= k) ans = max(ans, val);
            }
        }
        cout << ans;
    }
}

main() {
    ios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0);
    if(fopen(task".inp","r")) {
        freopen(task".inp","r",stdin);
        freopen(task".out","w",stdout);
    }
    cin >> n >> m >> k;
    for (int i = 1; i <= m; i++) cin >> a[i];
    for (int i = 1; i <= m; i++) cin >> b[i];
    for (int i = 1; i <= n; i++) {
        int sz; cin >> sz;
        for (int j = 1; j <= sz; j++) {
            int x; cin >> x;
            v[i].pb(x);
        }
    }
    giai2::solve();
}
