#include<bits/stdc++.h>
using namespace std;
#define ll long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define debug(x) cout<< #x << " = "<< x <<'\n'
#define Task "dsulz"
#define ii pair<int,int>
#define iii pair<int,ii>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const ll inf=1e18;
const ll N=1e6+5;
const ll mod=1e9+7;
const ll base=311;
const ll phainon=33550336;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask&~(1LL<<i))
inline ll add(ll a,ll b){
    ll res=a+b;
    if(res>=mod) res-=mod;
    return res;
}
ll sub(ll a,ll b){
    return ((a-b)%mod+mod)%mod;
}
inline ll mul(ll a,ll b){
    ll res=a*b;
    if(res>=mod) res%=mod;
    return res;
}
int tot,lz[N],p[N],n,val[N],q;
int acs(int u){
    if(u==p[u]) return u;
    int par=acs(p[u]);
    val[u]+=lz[par];
    lz[u]+=lz[par];
    return p[u]=par;
}
void up(int u,int x){
    u=acs(u);
    val[u]+=x;
    lz[u]+=x;
}
int get(int u){
    acs(u);
    return val[u];
}
void join(int u,int v){
    u=acs(u);
    v=acs(v);
    if(u!=v){
        tot++;
        p[u]=tot;
        p[v]=tot;
    }
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    if (fopen(Task ".inp","r")) {
        freopen(Task ".inp","r", stdin);
        freopen(Task ".out","w", stdout);
    }
    cin>>n>>q;
    for(int i=1;i<=n;i++){
        p[i]=i;
        tot++;
    }
    while(q--){
        int tp;
        cin>>tp;
        if(tp==1){
            int u,v;
            cin>>u>>v;
            join(u,v);
        }
        else if(tp==2){
            int u,x;
            cin>>u>>x;
            up(u,x);
        }
        else{
            int u;
            cin>>u;
            cout<<get(u)<<'\n';
        }
    }
}
