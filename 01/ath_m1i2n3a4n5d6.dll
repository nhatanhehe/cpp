/*
0 l r x : a[i]=a[i]&x.
1 l r   : min(a[i]).
*/
#include <bits/stdc++.h>
using namespace std;
#define task ""
#define int long long
#define ii pair<int,int>
#define fi first
#define se second
#define pb push_back

const int N=2e5+9;
const int inf=1e18;
const int mod=1e9+7;
int n,q,a[N];
ii st[N*4];
void sub1(){
    for(int i=1;i<=q;i++){
        int ty;
        cin>>ty;
        if(ty==1){
            int l,r;
            cin>>l>>r;
            int ans=2e9;
            for(int j=l;j<=r;j++){
                ans=min(ans,a[j]);
            }
            cout<<ans<<"\n";
        }
        else{
            int l,r,x;
            cin>>l>>r>>x;
            for(int j=l;j<=r;j++){
                a[j]&=x;
            }
        }
    }
}
void build(int i,int l,int r){
    if(l==r){
        st[i].fi=st[i].se=a[l];
        return;
    }
    build(i*2,l,(l+r)/2);
    build(i*2+1,(l+r)/2+1,r);

    st[i].se=(st[i*2].se|st[i*2+1].se);
    st[i].fi=min(st[i*2].fi,st[i*2+1].fi);
}
void Update(int i,int l,int r,int u,int v,int x){
    if(l>v || r<u) return;
    if(l<=u && v<=r){
        if((st[i].se&(~x))==0) return;
        if(u==v){
            st[i].se&=x;
            st[i].fi&=x;
            return;
        }
    }
    Update(i*2,l,r,u,(u+v)/2,x);
    Update(i*2+1,l,r,(u+v)/2+1,v,x);

    st[i].fi=min(st[i*2].fi,st[i*2+1].fi);
    st[i].se=(st[i*2].se|st[i*2+1].se);
}
int get(int i,int l,int r,int u,int v){
    if(l>v || r<u) return 2e9;
    if(l<=u && v<=r) return st[i].fi;
    return min(get(i*2,l,r,u,(u+v)/2),get(i*2+1,l,r,(u+v)/2+1,v));
}
void subac(){
    for(int i=1;i<=q;i++){
        int ty;
        cin>>ty;
        if(ty==1){
            int l,r;
            cin>>l>>r;
            cout<<get(1,l,r,1,n)<<"\n";
        }
        else
        {
            int l,r,x;
            cin>>l>>r>>x;
            Update(1,l,r,1,n,x);
        }
    }
}
signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);cout.tie(0);

//    freopen(task".inp","r",stdin);
//    freopen(task".out","w",stdout);

    cin>>n>>q;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    build(1,1,n);

        subac();
}

