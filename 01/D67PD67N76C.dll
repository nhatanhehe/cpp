#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=5e3+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i))
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
 return ((a%mod+b%mod)%mod+mod)%mod;
}
int n,k,a[N],pre[N][N],dp_before[N],dp_cur[N];
int C(int l,int r){
    return pre[r][r]-pre[l-1][r]-pre[r][l-1]+pre[l-1][l-1];
}
void dnc(int l,int r,int optl,int optr){
    if(l>r) return;
    int mid=(l+r)>>1;
    ii best={inf,-1};
    for(int i=optl;i<=min(optr,mid);i++){
        best=min(best,{dp_before[i]+C(i+1,mid),i});
    }
    dp_cur[mid]=best.fi;
    int opt=best.se;
    dnc(l,mid-1,optl,opt);
    dnc(mid+1,r,opt,optr);
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n>>k; k++;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    for(int i=1;i<=n;i++){
        for(int j=1;j<=n;j++){
            if(i<j) pre[i][j]=a[i]^a[j];
            pre[i][j]+=pre[i-1][j]+pre[i][j-1]-pre[i-1][j-1];
        }
    }
    for(int i=1;i<=n;i++){
        dp_before[i]=inf;
    }
    for(int i=1;i<=k;i++){
        dnc(0,n,0,n);
        for(int j=0;j<=n;j++) dp_before[j]=dp_cur[j];
    }
    cout<<dp_cur[n];
}
