#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb emplace_back
#define pf push_front
#define ii pair<int,int>
#define all(x) x.begin(),x.end()
#define iii pair<int,pair<int,int>>
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i))
int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,u,v,l,cnt[N*10],k,cen[N],sz[N];
vector<ii>g[N];
int dfs(int u,int p){
    sz[u]=1;
    for(ii x:g[u]){
        int v=x.fi;
        if(v!=p&&!cen[v]){
            sz[u]+=sz[v];
        }
    }
    return sz[u];
}
int find_centroid(int u,int p,int tree_sz){
    for(ii x:g[u]){
        int v=x.fi;
        if(v!=p&&!cen[v]&&sz[v]>tree_sz/2) return find_centroid(v,u,tree_sz);
    }
    return u;
}
int ans=inf;
void get(int u,int p,int h,int c){
    if(h>k) return;
    ans=min(ans,cnt[k-h]+c);
    for(ii x:g[u]){
        int v=x.fi;
        if(v!=p&&!cen[v]) get(v,u,h+x.se,c+1);
    }
}
int mx;
void up(int u,int p,int h,int c){
    if(h>k) return;
    cnt[h]=min(cnt[h],c);
    mx=max(mx,h);
    for(ii x:g[u]){
        int v=x.fi;
        if(v!=p&&!cen[v]) up(v,u,h+x.se,c+1);
    }
}
void build(int u){
    dfs(u,-1);
    int centroid=find_centroid(u,-1,sz[u]);
    cen[centroid]=1;
    cnt[0]=0;
    mx=0;
    for(ii x:g[centroid]){
        int v=x.fi;
        if(!cen[v]){
            get(v,-1,x.se,1);
            up(v,-1,x.se,1);
        }
    }
    for(int i=0;i<=mx;i++) cnt[i]=inf;
    for(ii x:g[centroid]){
        int v=x.fi;
        if(!cen[v]) build(v);
    }
}
main(){
     ios_base::sync_with_stdio(false);
     cin.tie(NULL);
       cout.tie(NULL);
    cin>>n>>k;
    for(int i=1;i<n;i++){
        cin>>u>>v>>l;
        u++;
        v++;
        g[u].pb(v,l);
        g[v].pb(u,l);
    }
    for(int i=1;i<=k;i++){
        cnt[i]=inf;
    }
    build(1);
    cout<<(ans==inf? -1:ans);
}
