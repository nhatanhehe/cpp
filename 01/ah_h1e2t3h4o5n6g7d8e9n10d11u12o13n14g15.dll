/*
 * =============================================================
 * ĐỀ BÀI: TÌM ĐỘ DÀI K LỚN NHẤT ĐỂ ĐẶT M DÃY ĐÈN
 * - Cho lưới n x n (n <= 1500) gồm các ô 1 (có thể lắp đèn) và 0 (bị chặn).
 * - Cần đặt m dãy đèn (m = 1 hoặc m = 2).
 * - Mỗi dãy đèn là một đoạn thẳng liên tiếp gồm đúng k ô 1 theo hàng hoặc cột.
 * - Nếu m = 2, hai dãy không được giao nhau và phải có cùng độ dài k.
 * - Yêu cầu: Tìm k lớn nhất có thể.
 *
 * GIẢI THUẬT:
 * 1. Trường hợp m = 1:
 * - Duyệt qua tất cả hàng và cột, tìm đoạn ô '1' liên tiếp dài nhất.
 * 2. Trường hợp m = 2:
 * - Tiền xử lý (DP):
 * + prehang[i]/sufhang[i]: Độ dài dãy đèn lớn nhất nằm trong các hàng từ 1->i hoặc i->n.
 * + precot[j]/sufcot[j]: Độ dài dãy đèn lớn nhất nằm trong các cột từ 1->j hoặc j->n.
 * - Duyệt mọi dãy đèn tiềm năng:
 * + Với mỗi dãy đèn (hàng hoặc cột) bắt đầu từ (i, j) có độ dài L, ta tìm dãy thứ hai
 * lớn nhất trong các vùng không gian không giao với nó (trên, dưới, trái, phải).
 * + Sử dụng các mảng pre/suf đã tính để lấy max vùng trong O(1).
 * + k_max = max(min(L, max_vùng_còn_lại)).
 * - Xử lý cùng hàng/cột:
 * + Với mỗi hàng/cột, tìm tất cả các đoạn '1' liên tiếp, lưu vào vector rồi sort.
 * + Lấy hai đoạn lớn nhất (v[0], v[1]) để cập nhật k = min(v[0], v[1]).
 * + Hoặc chia đôi một đoạn thẳng cực dài: k = L / 2.
 * - Độ phức tạp: O(n^2) (có sử dụng Binary Search/Sort nội bộ nhưng n=1500 vẫn đáp ứng tốt).
 * =============================================================
 */

#include<bits/stdc++.h>
#define task "main"
//#include <ext/pb_ds/assoc_container.hpp>
//#include <ext/pb_ds/tree_policy.hpp>
#define endl '\n'
#define int long long
#define pb push_back
#define fi first
#define se second
#define ii pair<int,int>
#define iii pair<int,ii>
#define iv pair<ii, ii>
#define base 341
#define MASK(i) (1ll << i)
#define oo 1e18
#define isOn(x,i) ((x) & MASK(i))
#define bitOn(x,i) ((x) | MASK(i))
#define bitOff(x,i) ((x) & ~MASK(i))
#define ordered_set tree<int, null_type,less<int>, rb_tree_tag,tree_order_statistics_node_update>
#define __lcm(a,b) (1ll * ((a) / __gcd((a), (b))) * (b))
using namespace std;
//using namespace __gnu_pbds;
const int maxn = 1505;

int n, m;
char a[maxn][maxn];

namespace giai1{

    int sufcot[maxn], sufhang[maxn], prehang[maxn], precot[maxn], sum[maxn];
    void tinh() {
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                sufcot[j] = 0;
                precot[j] = 0;
            }
            sufhang[i] = 0;
            prehang[i] = 0;
        }

        for (int i = n; i >= 1; i--) {
            int cnt = 0, maxi = 0;
            for (int j = 1; j <= n; j++) {
                if (a[i][j] == '1') {
                    cnt++;
                    maxi = max(maxi, cnt);
                }
                else cnt = 0;
            }
            sufhang[i] = max(sufhang[i + 1], maxi);
        }

        for (int j = n; j >= 1; j--) {
            int cnt = 0, maxi = 0;
            for (int i = 1; i <= n; i++) {
                if (a[i][j] == '1') {
                    cnt++;
                    maxi = max(maxi, cnt);
                }
                else cnt = 0;
            }
            sufcot[j] = max(sufcot[j + 1], maxi);
        }

        for (int i = 1; i <= n; i++) {
            int cnt = 0, maxi = 0;
            for (int j = 1; j <= n; j++) {
                if (a[i][j] == '1') {
                    cnt++;
                    maxi = max(maxi, cnt);
                }
                else cnt = 0;
            }
            prehang[i] = max(prehang[i - 1], maxi);
        }

        for (int j = 1; j <= n; j++) {
            int cnt = 0, maxi = 0;
            for (int i = 1; i <= n; i++) {
                if (a[i][j] == '1') {
                    cnt++;
                    maxi = max(maxi, cnt);
                }
                else cnt = 0;
            }
            precot[j] = max(precot[j - 1], maxi);
        }


        int maxi = 0;

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) sum[j] = sum[j - 1] + (a[i][j] == '1');
            for (int j = 1; j <= n; j++) {
                if (a[i][j] == '1') {
                    int l = 0, r = n - j, res = 0;
                    while(l <= r) {
                        int mid = (l + r) / 2;
                        if (sum[j + mid] - sum[j - 1] == (j + mid - j + 1)) {
                            res = mid;
                            l = mid + 1;
                        }
                        else r = mid - 1;
                    }
                    int val = min(res + 1, max({prehang[i - 1], sufhang[i + 1], precot[j - 1], sufcot[j + res + 1] }));
                    maxi = max(maxi, val);
                    maxi = max(maxi, (j + res - j + 1) / 2);
                }
            }
        }

        for (int j = 1; j <= n; j++) {
            for (int i = 1; i <= n; i++) sum[i] = sum[i - 1] + (a[i][j] == '1');
            for (int i = 1; i <= n; i++) {
                if (a[i][j] == '1') {
                    int l = 0, r = n - i, res = 0;
                    while(l <= r) {
                        int mid = (l + r) / 2;
                        if (sum[i + mid] - sum[i - 1] == (i + mid - i + 1)) {
                            res = mid;
                            l = mid + 1;
                        }
                        else r = mid - 1;
                    }
                    int val = min(res + 1, max({prehang[i - 1], sufhang[i + res + 1], precot[j - 1], sufcot[j + 1] }));
                    maxi = max(maxi, val);
                    maxi = max(maxi, (i + res - i + 1) / 2);
                }
            }
        }


        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) sum[j] = sum[j - 1] + (a[i][j] == '1');
            for (int j = n; j >= 1; j--) {
                if (a[i][j] == '1') {
                    int l = 0, r = j - 1, res = 0;
                    while(l <= r) {
                        int mid = (l + r) / 2;
                        if (sum[j] - sum[mid] == (j - mid)) {
                            res = mid;
                            r = mid - 1;
                        }
                        else l = mid + 1;
                    }
                    int val = min((j - res), max({prehang[i - 1], sufhang[i + 1], precot[res], sufcot[j + 1] }));
                    maxi = max(maxi, val);
                    maxi = max(maxi, (j - res) / 2);
                }
            }
        }

        for (int j = 1; j <= n; j++) {
            for (int i = 1; i <= n; i++) sum[i] = sum[i - 1] + (a[i][j] == '1');
            for (int i = 1; i <= n; i++) {
                if (a[i][j] == '1') {
                    int l = 0, r = i - 1, res = 0;
                    while(l <= r) {
                        int mid = (l + r) / 2;
                        if (sum[i] - sum[mid] == (i - mid)) {
                            res = mid;
                            r = mid - 1;
                        }
                        else l = mid + 1;
                    }
                    int val = min((i - res), max({prehang[res], sufhang[i + 1], precot[j - 1], sufcot[j + 1] }));
                    maxi = max(maxi, val);
                    maxi = max(maxi, (i - res) / 2);
                }
            }
        }


        for (int i = 1; i <= n; i++) {
            vector <int> v;
            int cnt = 0;
            for (int j = 1; j <= n; j++) {
                if (a[i][j] == '1') cnt++;
                else {
                    if (cnt) v.pb(cnt);
                    cnt = 0;
                }
            }
            if (cnt) v.pb(cnt);
            sort(v.begin(), v.end(), greater <int> ());
            if (v.size() >= 2) maxi = max(maxi, min(v[0], v[1]));
        }

        for (int j = 1; j <= n; j++) {
            vector <int> v;
            int cnt = 0;
            for (int i = 1; i <= n; i++) {
                if (a[i][j] == '1') cnt++;
                else {
                    if (cnt) v.pb(cnt);
                    cnt = 0;
                }
            }
            if (cnt) v.pb(cnt);
            sort(v.begin(), v.end(), greater <int> ());
            if (v.size() >= 2) maxi = max(maxi, min(v[0], v[1]));
        }

        cout << maxi;
    }

    void solve() {
        tinh();
    }
}

main() {
    ios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0);
    if(fopen(task".inp","r")) {
        freopen(task".inp","r",stdin);
        freopen(task".out","w",stdout);
    }
    cin >> n >> m;
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) cin >> a[i][j];
    }

    if (m == 1) {
        int maxi = 0;
        for (int i = 1; i <= n; i++) {
            int cnt = 0;
            for (int j = 1; j <= n; j++) {
                if (a[i][j] == '1') {
                    cnt++;
                    maxi = max(maxi, cnt);
                }
                else cnt = 0;
            }
        }

        for (int j = 1; j <= n; j++) {
            int cnt = 0;
            for (int i = 1; i <= n; i++) {
                if (a[i][j] == '1') {
                    cnt++;
                    maxi = max(maxi, cnt);
                }
                else cnt = 0;
            }
        }
        cout << maxi;
    }
    else giai1::solve();
}
