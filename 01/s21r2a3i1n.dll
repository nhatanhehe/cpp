#include<bits/stdc++.h>
using namespace std;
#define ll long long
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define debug(x) cout<< #x << " = "<< x <<'\n'
#define Task "a"
#define ii pair<int,int>
#define iii pair<int,ii>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const ll inf=1e18;
const ll N=2e5+5;
const ll mod=1e9+7;
const ll base=311;
const ll phainon=33550336;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask&~(1LL<<i))
inline ll add(ll a,ll b){
    ll res=a+b;
    if(res>=mod) res-=mod;
    return res;
}
ll sub(ll a,ll b){
    return ((a-b)%mod+mod)%mod;
}
inline ll mul(ll a,ll b){
    ll res=a*b;
    if(res>=mod) res%=mod;
    return res;
}
int n,q,a[N],b[N],rem[N],pre[N];
struct SegTree{
    vector<int>tree[3];
    vector<int>blocked,lazy;
    int n;
    void init(int _n){
        n=_n;
        tree[0].resize(n*4+4,0);
        tree[1].resize(n*4+4,0);
        tree[2].resize(n*4+4,0);
        blocked.resize(n*4+4,0);
        lazy.resize(n*4+4,0);
    }
    void build(int id=1,int l=1,int r=-1){
        if(r==-1) r=n;
        if(l==r){
            tree[0][id]=tree[1][id]=tree[2][id]=rem[l];
            return;
        }
        int mid=(l+r)>>1;
        build(id*2,l,mid);
        build(id*2+1,mid+1,r);
        tree[0][id]=min(tree[0][id*2],tree[0][id*2+1]);
        tree[1][id]=max(tree[1][id*2],tree[1][id*2+1]);
        tree[2][id]=tree[2][id*2]+tree[2][id*2+1];
    }
    void terminate(int id,int l,int r){
        blocked[id]=1;
        tree[0][id]=tree[1][id]=tree[2][id]=0;
        lazy[id]=0;
        if(l==r) return;
        int mid=(l+r)>>1;
        terminate(id*2,l,mid);
        terminate(id*2+1,mid+1,r);
    }
    void fix(int id,int l,int r,int k){
        if(blocked[id]) return;
        tree[0][id]+=k;
        tree[1][id]+=k;
        tree[2][id]+=(r-l+1)*k;
        lazy[id]+=k;
    }
    void push(int id,int l,int r){
        if(lazy[id]){
            int mid=(l+r)>>1;
            fix(id*2,l,mid,lazy[id]);
            fix(id*2+1,mid+1,r,lazy[id]);
            lazy[id]=0;
        }
    }
    void up(int u,int v,int d,int id=1,int l=1,int r=-1){
        if(r==-1) r=n;
        if(blocked[id]) return;
        if(l>v||r<u) return;
        if(u<=l&&r<=v){
            if(tree[0][id]>=d){
                fix(id,l,r,-d);
                return;
            }
            if(tree[1][id]<=d){
                terminate(id,l,r);
                return;
            }
        }
        push(id,l,r);
        int mid=(l+r)>>1;
        up(u,v,d,id*2,l,mid);
        up(u,v,d,id*2+1,mid+1,r);
        tree[0][id]=min(tree[0][id*2],tree[0][id*2+1]);
        tree[1][id]=max(tree[1][id*2],tree[1][id*2+1]);
        tree[2][id]=tree[2][id*2]+tree[2][id*2+1];
    }
    int get(int u,int v,int id=1,int l=1,int r=-1){
        if(r==-1) r=n;
        if(l>v||r<u) return 0;
        if(blocked[id]) return 0;
        if(u<=l&&r<=v) return tree[2][id];
        push(id,l,r);
        int mid=(l+r)>>1;
        return get(u,v,id*2,l,mid)+get(u,v,id*2+1,mid+1,r);
    }
    int db(int pos,int id=1,int l=1,int r=-1){
        if(r==-1) r=n;
        if(l==r){
            return tree[2][id];
        }
        int mid=(l+r)>>1;
        if(pos<=mid) return db(pos,id*2,l,mid);
        else return db(pos,id*2+1,mid+1,r);
    }
};
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    if (fopen(Task ".inp","r")) {
        freopen(Task ".inp","r", stdin);
        freopen(Task ".out","w", stdout);
    }
    cin>>n>>q;
    for(int i=1;i<=n;i++){
        cin>>a[i];
        pre[i]=pre[i-1]+a[i];
    }
    for(int i=1;i<=n;i++){
        cin>>b[i];
        rem[i]=a[i]-b[i];
    }
    SegTree seg;
    seg.init(n);
    seg.build();
    while(q--){
        int tp;
        cin>>tp;
        if(tp==1){
            int l,r,d;
            cin>>l>>r>>d;
            seg.up(l,r,d);
        }
        else{
            int l,r;
            cin>>l>>r;
            cout<<pre[r]-pre[l-1]-seg.get(l,r)<<'\n';
        }
    }
}
