#include<bits/stdc++.h>
#define endl '\n'
#define int long long
#define pb push_back
#define fi first
#define se second
#define ii pair<int,int>
#define iii pair <int, ii>
using namespace std;
const int maxn = 1e6 + 5;

int n, u, q, k, a[maxn], b[maxn], cnt[maxn];
deque <int> dq;

bool check(int mid) {
    int sum = 0;
    for (int i = 1; i <= n; i++) {
        b[i] = a[i];
        cnt[i] = 0;
    }

    dq.clear();

    for (int i = 1; i < k; i++) {
        sum += b[i];
        dq.pb(i);
    }

    int res = 0;
    for (int i = k; i <= n; i++) {
        sum += b[i] - b[i - k];
        dq.pb(i);
        if (i - k >= 1) {
            while(!dq.empty() && dq.front() == i - k) dq.pop_front();
        }

        while(sum < mid) {
            if (dq.empty()) return false;
            int last = dq.back();

            int need = min(u - cnt[last], mid - sum);

            cnt[last] += need;
            sum += need;
            b[last] += need;
            res += need;

            if (cnt[last] == u) dq.pop_back();
        }
    }

    int remain = 0;
    for (int i = 1; i <= n; i++) remain += u - cnt[i];

//    for (int i = 1; i <= n; i++) cout << b[i] << " ";
//    cout << endl;

    if (res == q) return true;
    else if (res < q) {
        int tmp = q - res;
        return (remain >= tmp);
    }
    else return false;
}

main() {
    ios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0);
    freopen("robo.inp", "r", stdin);
    freopen("robo.out", "w", stdout);

    cin >> n >> u >> q >> k;
    for (int i = 1; i <= n; i++) cin >> a[i];
    q = min(q, n * u);

  //  cout << check(11);

    //return 0;
    int l = 0, r = 1e15, res = 0;
    while(l <= r) {
        int mid = (l + r) / 2;
        if (check(mid)) {
            res = mid;
            l = mid + 1;
        }
        else r = mid - 1;
    }
    cout << res;
}
