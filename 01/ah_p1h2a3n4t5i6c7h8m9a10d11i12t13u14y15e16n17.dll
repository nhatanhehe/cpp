/* * =============================================================================
 * TÓM TẮT ĐỀ BÀI: (Bài toán Cắt cân bằng chuỗi gen - Image 6)
 * - Cho chuỗi mã di truyền S có độ dài N (N <= 10^6) gồm các ký tự 'a' đến 'z'.
 * - Một phép cắt một đoạn con thành K+1 đoạn liên tiếp được gọi là "cân bằng"
 * nếu tất cả các đoạn thu được đều chứa cùng một số lượng ký tự phân biệt.
 * - Yêu cầu: Tính tổng số cách cắt cân bằng cho TẤT CẢ các đoạn con liên tiếp của S
 * (chỉ tính các trường hợp cắt thành từ hai đoạn trở lên).
 * - Kết quả in ra theo modulo 10^9 + 7.
 * * GIẢI THUẬT:
 * 1. Ý tưởng chủ đạo:
 * - Vì số lượng ký tự phân biệt tối đa trong một đoạn chỉ là 26 ('a'-'z'),
 * ta có thể duyệt qua từng giá trị d (từ 1 đến 26), với d là số lượng ký tự
 * phân biệt mà mỗi đoạn con sau khi cắt phải có.
 * 2. Quy hoạch động (DP) & Sliding Window:
 * - Với mỗi giá trị d cố định:
 * + Sử dụng hai con trỏ (jpos, kpos) để duy trì cửa sổ trượt trên chuỗi.
 * + [kpos, jpos] là khoảng các chỉ số bắt đầu p sao cho đoạn S[p...i]
 * có đúng d ký tự phân biệt.
 * + dp[i]: Số lượng cách phân chia tiền tố kết thúc tại i thành các đoạn,
 * mỗi đoạn có đúng d ký tự phân biệt.
 * + pre[i]: Mảng cộng dồn của dp[i] để truy vấn nhanh số cách cắt ở các bước trước.
 * 3. Tính toán:
 * - Với mỗi i, nếu tồn tại các đoạn S[p...i] có d ký tự phân biệt, ta cập nhật:
 * res = res + (tổng số cách cắt đã có từ trước trong khoảng [kpos, jpos]).
 * - Tổng res sau khi duyệt qua tất cả d từ 1 đến 26 chính là đáp án cần tìm.
 * 4. Độ phức tạp: O(26 * N), đáp ứng tốt với N = 10^6 trong giới hạn thời gian.
 * =============================================================================
 */

#include<bits/stdc++.h>
#define task "main"
//#include <ext/pb_ds/assoc_container.hpp>
//#include <ext/pb_ds/tree_policy.hpp>
#define endl '\n'
#define int long long
#define pb push_back
#define fi first
#define se second
#define ii pair<int,int>
#define iii pair<int,ii>
#define iv pair<ii, ii>
#define base 341
#define MASK(i) (1ll << i)
#define oo 1e18
#define isOn(x,i) ((x) & MASK(i))
#define bitOn(x,i) ((x) | MASK(i))
#define bitOff(x,i) ((x) & ~MASK(i))
#define ordered_set tree<int, null_type,less<int>, rb_tree_tag,tree_order_statistics_node_update>
#define __lcm(a,b) (1ll * ((a) / __gcd((a), (b))) * (b))
using namespace std;
//using namespace __gnu_pbds;
const int maxn = 1e6 + 5;
const int mod = 1e9 + 7;

int n, a[maxn];
int cntj[26], cntk[26];
int ansj, ansk, jpos, kpos;
int dp[maxn], pre[maxn];
string s;

inline int addmod(int x, int y) {
    x %= mod; y %= mod;
    x += y;
    if (x >= mod) x -= mod;
    if (x < 0) x += mod;
    return x;
}

int32_t main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    if (fopen(task".inp","r")) {
        freopen(task".inp","r",stdin);
        freopen(task".out","w",stdout);
    }

    cin >> n >> s;
    s = " " + s;

    for (int i = 1; i <= n; i++) a[i] = s[i] - 'a';

    int res = 0;

    for (int d = 1; d <= 26; d++) {
        memset(cntj, 0, sizeof(cntj));
        memset(cntk, 0, sizeof(cntk));
        for (int i = 1; i <= n; i++) dp[i] = pre[i] = 0;

        ansj = ansk = 0;
        jpos = kpos = 1;

        for (int i = 1; i <= n; i++) {
            cntj[a[i]]++;
            if (cntj[a[i]] == 1) ansj++;

            cntk[a[i]]++;
            if (cntk[a[i]] == 1) ansk++;

            while (ansj >= d) {
                if (cntj[a[jpos]] == 1 && ansj == d) break;
                cntj[a[jpos]]--;
                if (cntj[a[jpos]] == 0) ansj--;
                jpos++;
            }

            while (ansk > d) {
                cntk[a[kpos]]--;
                if (cntk[a[kpos]] == 0) ansk--;
                kpos++;
            }

            if (ansj == d && ansk == d) {
                int val = addmod(pre[jpos - 1], -pre[kpos - 2]);
                if (val < 0) val = 0;
                res = addmod(res, val);
                dp[i] = addmod(val, jpos - kpos + 1);
            }

            pre[i] = addmod(pre[i - 1], dp[i]);
        }
    }

    cout << res;
}
 
