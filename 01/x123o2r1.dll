#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i)) 
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,a[N],b[N],m;
struct trie{
    trie *child[2];
    bool cnt;
    trie(){
        cnt=0;
        for(int i=0;i<2;i++) child[i]=NULL;
    }
};
trie *root;
void ins(string s){
    trie *p=root;
    for(auto x:s){
        if(p->child[x-'0']==NULL) p->child[x-'0']=new trie();
        p=p->child[x-'0'];
    }
}
string ans;
void get(string t){
    trie *p=root;
    bool tf=0;
    for(char x:t){
        if(tf){
            ans.pb('0');
            continue;
        }
        if(x=='0'){
            if(p->child[1]!=NULL){
                p=p->child[1];
                ans.pb('1');
                continue;
            }
            if(p->child[0]!=NULL){
                p=p->child[0];
                ans.pb('0');
                continue;
            }
            tf=1;
        }
        else{
            if(p->child[0]!=NULL){
                p=p->child[0];
                ans.pb('1');
                continue;
            }
            if(p->child[1]!=NULL){
                p=p->child[1];
                ans.pb('0');
                continue;
            }
            tf=1;
        }
    }

}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n;
    root=new trie();
    for(int i=1;i<=n;i++){
        cin>>a[i];
        string t;
        for(int j=0;j<32;j++){
            if((a[i]>>j)&1) t.pb('1');
            else t.pb('0');
        }
        reverse(all(t));
        ins(t);
    }
    cin>>m;
    for(int i=1;i<=m;i++){
        int x;
        cin>>x;
        string t;
        for(int j=0;j<32;j++){
            if((x>>j)&1) t.pb('1');
            else t.pb('0');
        }
        reverse(all(t));
        ans.clear();
        get(t);
        reverse(all(ans));
        int res=0;
        for(int j=0;j<ans.size();j++){
            if(ans[j]=='1') res+=(1<<j);
        }
        cout<<(res^x)<<" ";
    }
}
