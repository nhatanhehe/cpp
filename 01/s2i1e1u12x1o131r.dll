#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=1e6+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i)) 
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,a[N],s[N],k,dp[N];
struct Node{
    int cnt;
    Node *child[2];
    Node(){
        cnt=0;
        child[1]=child[0]=NULL;
    }
}*root;
void ins(Node *p,int x,int bit){
    if(bit==-1){
        p->cnt++;
        return;
    }
    int c=(x>>bit)&1;
    if(p->child[c]==NULL) p->child[c]=new Node();
    ins(p->child[c],x,bit-1);
    p->cnt=0;
    if(p->child[0]) p->cnt+=p->child[0]->cnt;
    if(p->child[1]) p->cnt+=p->child[1]->cnt;
}
int ans;
void get(Node *p,int x,int bit){
    if(bit==-1){
        ans+=p->cnt;
        return;
    }
    int c=(x>>bit)&1;
    int bk=(k>>bit)&1;
    if(bk){
        if(p->child[c]){
            ans+=p->child[c]->cnt;
        }
        if(p->child[c^1]) get(p->child[c^1],x,bit-1);
    }
    else{
        if(p->child[c]) get(p->child[c],x,bit-1);
    }
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n>>k;
    root=new Node();
    for(int i=1;i<=n;i++){
        cin>>a[i];
        s[i]=s[i-1]^a[i];
    }
    for(int i=1;i<=n;i++){
        ins(root,s[i-1],31);
        get(root,s[i],31);
    }    
    cout<<ans<<" ";
}
// a' du` thang nay chef code a`
