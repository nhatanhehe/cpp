#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i)) 
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,m;
string s,t[N];
struct Node{
    int cnt;
    Node *child[26];
    Node(){
        cnt=0;
        for(int i=0;i<26;i++){
            child[i]=NULL;
        }
    }
}*root=new Node();
void ins(string s,int pos){
    Node *p=root;
    for(char x:s){
        if('A'<=x&&x<='Z') x+=32;
        if(p->child[x-'a']==NULL) p->child[x-'a']=new Node();
        p=p->child[x-'a']; 
    }
    p->cnt=pos;
}
int trace[N],dp[N];
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n>>s>>m;
    s=" "+s;
    t[0]="";
    for(int i=1;i<=m;i++){
        cin>>t[i];
        ins(t[i],i);
    }
    for(int i=1;i<=n;i++){
        Node *p=root;
        dp[i]=inf;
        trace[i]=-1;
        for(int j=i;j>=1;j--){
            if(p->child[s[j]-'a']){
                p=p->child[s[j]-'a'];
            }
            else{
                break;
            }
            if(p->cnt!=0&&dp[j-1]!=inf){
                dp[i]=p->cnt;
                trace[i]=j-1;
                break;
            }
        }
    }
   // for(int i=1;i<=n;i++) cout<<dp[i]<<" ";
    vector<string>ans;
    int pos=n;
    while(pos>0){
        ans.pb(t[dp[pos]]);
        pos=trace[pos];
    }
    reverse(all(ans));
    for(auto x:ans) if(x.size())cout<<x<<" ";
}
// a' du` thang nay chef code a`
