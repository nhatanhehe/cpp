#include <bits/stdc++.h>
#define task "STABILITY"
#define int long long
#define ll long long
#define ld long double
#define ii pair<int, int>
#define fi first
#define se second
#define all(x) x.begin(), x.end()
#define mems(x, y) memset(x, y, sizeof(x));
using namespace std;
const int mod = 1e9 + 7, moi = 1e6 + 9;
const ll INF = 1e18;
const ld EFS = 1e-12;
const int dx[] = { 1, -1, 0, 0};
const int dy[] = { 0, 0, 1, -1};

ll add(ll t, ll x) {
    t += x;

    if(t >= mod) t -= mod;
    if(t < 0) t += mod;

    return t;
}

ll mul(ll t, ll x) {
    return ((t % mod) * (x % mod)) % mod;
}

int n, a[moi];
ll sum[moi];

void pre() {
    int Max = 1e6;
    for(int i = 1; i <= 1e6; i++) {
        int j = i;
        sum[i] = 1;

        while(j % 2 == 0) {
            sum[i] *= 2;
            j /= 2;
        }
    }
}

void sub2() {
    pre();
    ll ans = 0;

    for(int i = 1; i <= n; i++) {
        ll res = 0;
        for(int j = i; j <= n; j++) {
            res += a[j];
            ans = add(ans, sum[res]);

            //cout << res << " " << sum[res] << '\n';
        }
    }

    cout << ans;
}

ll mp[moi];

void sub4() {

    ll kq = 0, tongphu = 0;

    for(int i = 19; i >= 0; i--) {

        for(int s = 0; s <= 1e6; s++) mp[s] = 0;

        ll du = (1 << i), res = 0, ans = 0;
        mp[0] = 1;

        for(int j = 1; j <= n; j++) {
            res += a[j];
            res %= du;

            ans += mp[res];
            mp[res]++;
        }

        ans -= tongphu;
        tongphu += ans;

        kq = add(kq, mul(ans, du));
    }

    cout << kq;
}

void Input() {
    cin >> n;

    for(int i = 1; i <= n; i++) cin >> a[i];

    if(n <= 5000) {
        sub2();
        return;
    }

    if(n <= 2e5) {
        sub4();
        return;
    }
}

main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);

    if(fopen(task".inp","r")){
        freopen(task".inp","r",stdin);
        freopen(task".out","w",stdout);
    }
    int t = 1;
    //cin >> t;
    while (t --) {
        Input();
    }

    cerr << "Time: " << (1.0 * clock() / CLOCKS_PER_SEC) << " s.\n";
}
