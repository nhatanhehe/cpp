/*
1 l r c: a[i]= [a[i]/c] (chia nguyen lay san)
2 l r c: a[i]=a[i]+c.
3 l r : min(a[l]->a[r]).
3 l r : sum(a[l]->a[r]).
*/
#include <bits/stdc++.h>
#define int long long
using namespace std;
const int N = 1e5 + 10;
const int INF = 1e18;
int n, q, a[N];
#define ls(x) (x<<1)
#define rs(x) (x<<1|1)
int sum[N << 2], tag[N << 2], minn[N << 2], maxn[N << 2];
void push_up(int u) {
    sum[u] = sum[ls(u)] + sum[rs(u)];
    minn[u] = min(minn[ls(u)], minn[rs(u)]);
    maxn[u] = max(maxn[ls(u)], maxn[rs(u)]);
}
void build(int u, int L, int R) {
    if (L == R) {
        sum[u] = minn[u] = maxn[u] = a[L];
        return;
    }

    int M = L + R >> 1;
    build(ls(u), L, M);
    build(rs(u), M + 1, R);
    push_up(u);
}
void make_tag(int u, int L, int R, int x) {
    sum[u] += (R - L + 1) * x;
    tag[u] += x;
    minn[u] += x;
    maxn[u] += x;
}
void push_down(int u, int L, int R) {
    if (tag[u]) {
        int M = L + R >> 1;
        make_tag(ls(u), L, M, tag[u]);
        make_tag(rs(u), M + 1, R, tag[u]);
        tag[u] = 0;
    }
}
void update_add(int u, int L, int R, int l, int r, int x) {
    if (l <= L && R <= r) {
        make_tag(u, L, R, x);
        return;
    }

    int M = L + R >> 1;
    push_down(u, L, R);

    if (l <= M)
        update_add(ls(u), L, M, l, r, x);

    if (r > M)
        update_add(rs(u), M + 1, R, l, r, x);

    push_up(u);
}
void update_div(int u, int L, int R, int l, int r, int d) {
    if (l <= L && R <= r) {
        if (maxn[u] - floor(1.0 * maxn[u] / d) == minn[u] - floor(1.0 * minn[u] / d)) {
            make_tag(u, L, R, floor(1.0 * maxn[u] / d) - maxn[u]);
            return;
        }
    }

    int M = L + R >> 1;
    push_down(u, L, R);

    if (l <= M)
        update_div(ls(u), L, M, l, r, d);

    if (r > M)
        update_div(rs(u), M + 1, R, l, r, d);

    push_up(u);
}
int query_min(int u, int L, int R, int l, int r) {
    if (l <= L && R <= r)
        return minn[u];

    int M = L + R >> 1, res = INF;
    push_down(u, L, R);

    if (l <= M)
        res = min(res, query_min(ls(u), L, M, l, r));

    if (r > M)
        res = min(res, query_min(rs(u), M + 1, R, l, r));

    return res;
}
int query_sum(int u, int L, int R, int l, int r) {
    if (l <= L && R <= r)
        return sum[u];

    int M = L + R >> 1, res = 0;
    push_down(u, L, R);

    if (l <= M)
        res += query_sum(ls(u), L, M, l, r);

    if (r > M)
        res += query_sum(rs(u), M + 1, R, l, r);

    return res;
}
signed main() {
    cin >> n >> q;

    for (int i = 1; i <= n; i++)
        cin >> a[i];

    build(1, 1, n);

    while (q--) {
        int op, l, r, x;
        cin >> op >> l >> r;
        l++, r++;

        if (op == 1) {
            cin >> x;
            update_add(1, 1, n, l, r, x);
        }

        if (op == 2) {
            cin >> x;
            update_div(1, 1, n, l, r, x);
        }

        if (op == 3) {
            cout << query_min(1, 1, n, l, r) << endl;
        }

        if (op == 4) {
            cout << query_sum(1, 1, n, l, r) << endl;
        }
    }

    return 0;
}
