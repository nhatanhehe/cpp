#include <bits/stdc++.h>
#define task "main"
#define endl '\n'
#define pb push_back
#define fi first
#define se second
#define ii pair<int,int>
using namespace std;
using ll = long long;
const int maxn = 1000005;

int n, q;
int a[maxn];
int mod = 998244353;

namespace giai2{

    int pre[maxn][5], sl[5], p[maxn];
    inline int mul(int x, int y) {
        return int((1LL * x * y) % mod);
    }
    void solve() {
        p[0] = 1;
        for (int i = 1; i <= n; i++) {
            p[i] = mul(p[i - 1], 2);

            pre[i][1] = pre[i - 1][1] + (a[i] == 1);
            pre[i][2] = pre[i - 1][2] + (a[i] == 2);
            pre[i][3] = pre[i - 1][3] + (a[i] == 3);
        }

        for (int test = 1; test <= q; test++) {
            int l, r; cin >> l >> r;

            sl[1] = pre[r][1] - pre[l - 1][1]; sl[2] = pre[r][2] - pre[l - 1][2]; sl[3] = pre[r][3] - pre[l - 1][3];

            int stpb = (sl[1] > 0) + (sl[2] > 0) + (sl[3] > 0);

            int tich = 1;
            for (int i = 1; i <= 3; i++) {
                if (sl[i]) tich = mul(tich, p[sl[i] - 1]);
            }
            tich = mul(tich, stpb + 1);
            cout << ((tich - 1) % mod + mod) % mod << endl;
        }
    }
}

namespace giai3{
    int d[maxn], p[maxn];

    inline int mul(int x, int y) {
        return int((1LL * x * y) % mod);
    }

    void solve() {

        p[0] = 1;
        for (int i = 1; i <= n; i++) p[i] = mul(p[i - 1], 2);

        for (int test = 1; test <= q; test++) {
            int l, r; cin >> l >> r;

            vector<int> v;
            for (int i = l; i <= r; i++) {
                d[a[i]]++;

                if (d[a[i]] == 1) v.pb(a[i]);
            }

            int stpb = (int)v.size(); int tich = 1;
            for (int x : v) tich = mul(tich, p[d[x] - 1]);
            tich = mul(tich, stpb + 1);
            cout << ((tich - 1) % mod + mod) % mod << endl;

            for (int x : v) d[x] = 0;
        }
    }
}

namespace giai4{

    vector<ii> query[maxn];
    int d[maxn], p[maxn];

    struct fen {
        int n;
        vector<int> bit;
        fen() : n(0) {}
        fen(int _n) {
            n = _n;
            bit.assign(n + 5, 0);
        }
        void update(int pos, int v) {
            for (int i = pos; i <= n; i += i & -i)
                bit[i] += v;
        }
        int get(int pos) {
            int res = 0;
            for (int i = pos; i; i -= i & -i)
                res += bit[i];
            return res;
        }
        void updateRange(int l, int r, int v) {
            update(l, v);
            update(r + 1, -v);
        }
        int getRange(int l, int r) {
            if (l - 1 == 0) return get(r);
            return get(r) - get(l - 1);
        }
    } bit;

    inline int mul(int x, int y) {
        return int((1LL * x * y) % mod);
    }
    int ans[maxn];

    void solve() {
        p[0] = 1;
        for (int i = 1; i <= n; i++) p[i] = mul(p[i - 1], 2);

        for (int test = 1; test <= q; test++) {
            int l, r; cin >> l >> r;
            query[r].pb({l, test});
        }

        bit = fen(n + 2);

        for (int i = 1; i <= n; i++) {
            if (d[a[i]] == 0) d[a[i]] = i;
            else bit.update(d[a[i]], -1);

            bit.update(i, 1);
            d[a[i]] = i;

            for (auto e : query[i]) {
                int l = e.fi, id = e.se;
                int val = bit.getRange(l, i);

                ans[id] = ((mul(p[i - l + 1 - val], val + 1) - 1) % mod + mod) % mod;
            }
        }

        for (int i = 1; i <= q; i++) cout << ans[i] << endl;
    }
}

int main() {
    ios_base::sync_with_stdio(0); cin.tie(0); cout.tie(0);
    // freopen("symball.inp", "r", stdin);
    // freopen("symball.out", "w", stdout);

    cin >> n >> q;

    vector<int> nen;

    bool ok2 = true;
    for (int i = 1; i <= n; i++) {
        cin >> a[i];
        nen.pb(a[i]);

        if (a[i] > 3) ok2 = false;
    }

    sort(nen.begin(), nen.end());
    nen.erase(unique(nen.begin(), nen.end()), nen.end());
    for (int i = 1; i <= n; i++) {
        a[i] = int(lower_bound(nen.begin(), nen.end(), a[i]) - nen.begin() + 1);
    }

    if (ok2 && n <= 400000 && q <= 400000) giai2::solve();
    else if (1LL * q * n <= 5000000) giai3::solve();
    else giai4::solve();

    return 0;
}
