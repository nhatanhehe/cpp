#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i)) 
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,q,a[N],ans[N];
string s[N];
struct Node{
    int last;
    Node *child[2];
    Node(){
        last=0;
        child[0]=child[1]=NULL;
    }
}*root;
struct pt{
    int last;
    string s;
    int pos;
};
vector<pt>query[N];
void ins(string s,int l){
    Node *p=root;
    for(char x:s){
        if(p->child[x-'0']==NULL) p->child[x-'0']=new Node();
        p=p->child[x-'0'];
        p->last=l;
    }
}
int get(string s,int l){
    Node *p=root;
    string ans;
    bool tf=0;
    for(char x:s){
        if(tf){
            ans.pb(x);
            continue;
        }
        if(x=='0'){
            if(p->child[1]&&p->child[1]->last>=l){
                p=p->child[1];
                ans.pb('1');
                continue;
            }
            if(p->child[0]&&p->child[0]->last>=l){
                p=p->child[0];
                ans.pb('0');
                continue;
            }
            tf=1;
        }
        else{
            if(p->child[0]&&p->child[0]->last>=l){
                p=p->child[0];
                ans.pb('1');
                continue;
            }
            if(p->child[1]&&p->child[1]->last>=l){
                ans.pb('0');
                p=p->child[1];
                continue;
            }
            tf=1;
        }
    }
    reverse(all(ans));
    int res=0;
    for(int i=0;i<ans.size();i++) if(ans[i]=='1')res+=(1<<i);
    return res;
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    root=new Node();
    cin>>n;
    for(int i=1;i<=n;i++){
        cin>>a[i];
        for(int j=19;j>=0;j--){
            s[i].pb(((a[i]>>j)&1)+'0');
        }
    }
    cin>>q;
    for(int i=1;i<=q;i++){
        int l,r,x;
        cin>>l>>r>>x;
        string t;
        for(int j=19;j>=0;j--){
            t.pb(((x>>j)&1)+'0');
        }
        query[r].pb({l,t,i});
    }
    for(int i=1;i<=n;i++){
        ins(s[i],i);
        for(auto x:query[i]){
            int l=x.last;
            string s=x.s;
            int pos=x.pos;
            ans[pos]=get(s,l);
        }
    }
    for(int i=1;i<=q;i++) cout<<ans[i]<<'\n';
}
