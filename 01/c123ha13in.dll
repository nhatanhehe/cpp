#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5+5e4;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i)) 
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,ans;
string s[N];
struct Node{
    int lis;
    Node *child[26];
    Node(){
        for(int i=0;i<26;i++) child[i]=NULL;
        lis=0;
    }
}*root;
void ins(string s,int mx){
    Node *p=root;
    for(int x:s){
        if(p->child[x-'a']==NULL) p->child[x-'a']=new Node();
        p=p->child[x-'a'];
    }
    p->lis=mx;
    ans=max(ans,mx);
}
int get(string s){
    Node *p=root;
    int Max=0;
    for(int x:s){
        Max=max(Max,p->lis);
        if(p->child[x-'a']==NULL) break;
        p=p->child[x-'a'];
    }
    return Max;
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    root=new Node();
    cin>>n;
    for(int i=1;i<=n;i++){
        cin>>s[i]; 
    }
    sort(s+1,s+n+1);
    for(int i=1;i<=n;i++){
        int Lis=get(s[i])+1;
        ins(s[i],Lis);
    }
    cout<<ans;
}
