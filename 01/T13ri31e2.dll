struct Trie {
    struct node {
        node* child[26];
        bool cnt;
        node() {
            cnt = 0;
            for(int i=0;i<26;i++) child[i] = nullptr;
        }
    };

    node *root;

    Trie() {
        root = new node();
    }

    void insert(string s) {
        node *p = root;
        for(auto x: s){
            if(p->child[x-'a'] == nullptr)
                p->child[x-'a'] = new node();
            p = p->child[x-'a'];
        }
        p->cnt = 1;
    }

    bool search(string s){
        node *p = root;
        for(auto x: s){
            if(p->child[x-'a'] == nullptr) return false;
            p = p->child[x-'a'];
        }
        return p->cnt;
    }
};

