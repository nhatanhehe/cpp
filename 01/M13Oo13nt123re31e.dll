#include<bits/stdc++.h>
using namespace std;
#define ll long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define debug(x) cout<< #x << " = "<< x <<'\n'
#define Task "a"
#define ii pair<int,int>
#define iii pair<int,ii>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const ll inf=1e18;
const ll N=1299709+5;
const ll mod=1e9+7;
const ll base=311;
const ll phainon=33550336;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask&~(1LL<<i))
inline ll add(ll a,ll b){
    ll res=a+b;
    if(res>=mod) res-=mod;
    return res;
}
ll sub(ll a,ll b){
    return ((a-b)%mod+mod)%mod;
}
inline ll mul(ll a,ll b){
    ll res=a*b;
    if(res>=mod) res%=mod;
    return res;
}
int n,q,w[N],u,v,st[N],en[N],timer,h[N],p[N][20],S,ver[N];
vector<int>g[N];
void dfs(int u,int par){
    st[u]=++timer;
    ver[timer]=u;
    for(int v:g[u]){
        if(v!=par){
            h[v]=h[u]+1;
            p[v][0]=u;
            dfs(v,u);
        }
    }
    en[u]=++timer;
    ver[timer]=u;
}
int lca(int u,int v){
    if(h[u]<h[v]) swap(u,v);
    for(int i=19;i>=0;i--){
        if(h[u]-h[v]>=(1<<i)) u=p[u][i];
    }
    if(u==v) return u;
    for(int i=19;i>=0;i--){
        if(p[u][i]!=p[v][i]){
            u=p[u][i];
            v=p[v][i];
        }
    }
    return p[u][0];
}
const int BLOCK=317;
int cnt[BLOCK+5][BLOCK+5],ans[N],check[N];
int prime[N],m=-1,id[N];
bool pr[N];
void sang(){
    memset(pr,1,sizeof pr);
    pr[0]=pr[1]=0;
    for(int i=2;i<=sqrt(1299709);i++){
        if(pr[i])
        for(int j=i*i;j<=1299709;j+=i){
            pr[j]=0;
        }
    }
}
struct pt{
    int l,r,lc,id;
};
pt qr[N];
int vis[N];
void up(int u){
    if(!pr[w[u]]||w[u]>1299709) return;
    int x=id[w[u]];
    if(vis[u]){
        cnt[x/BLOCK][x%BLOCK]--;
        if(!cnt[x/BLOCK][x%BLOCK]) check[x/BLOCK]--;
    }
    else{
        cnt[x/BLOCK][x%BLOCK]++;
        if(cnt[x/BLOCK][x%BLOCK]==1) check[x/BLOCK]++;
    }
    vis[u]^=1;
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    if (fopen(Task ".inp","r")) {
        freopen(Task ".inp","r", stdin);
        freopen(Task ".out","w", stdout);
    }
    cin>>n;
    S=sqrt(n);
    for(int i=1;i<=n;i++){
        cin>>w[i];
    }
    for(int i=1;i<n;i++){
        cin>>u>>v;
        g[u].pb(v);
        g[v].pb(u);
    }
    dfs(1,-1);
    for(int j=1;j<=19;j++){
        for(int i=1;i<=n;i++){
            p[i][j]=p[p[i][j-1]][j-1];
        }
    }
    sang();
    for(int i=2;i<=1299709;i++){
        if(pr[i]){
            prime[++m]=i;
            id[i]=m;
        }
    }
    cin>>q;
    for(int i=1;i<=q;i++){
        cin>>u>>v;
        if(st[u]>st[v]) swap(u,v);
        int lc=lca(u,v);
        if(lc==u) qr[i]={st[u],st[v],lc,i};
        else qr[i]={en[u],st[v],lc,i};
    }
    sort(qr+1,qr+q+1,[&](const pt &x,const pt &y){
        if(x.l/S!=y.l/S) return x.l<y.l;
        return x.r<y.r;
    });
    int l=1,r=0;
    for(int i=1;i<=q;i++){
        auto [L,R,lc,idx]=qr[i];
        while(l>L) up(ver[--l]);
        while(r<R) up(ver[++r]);
        while(l<L) up(ver[l++]);
        while(r>R) up(ver[r--]);
        int u=ver[L],v=ver[R];
        if(lc!=u&&lc!=v) up(lc);
        for(int block=0;block<=317;block++){
            if(check[block]!=317){
                for(int j=0;j<=316;j++){
                    if(!cnt[block][j]){
                        ans[idx]=BLOCK*block+j;
                        break;
                    }
                }
                break;
            }
        }
        if(lc!=u&&lc!=v) up(lc);
    }
    for(int i=1;i<=q;i++) cout<<prime[ans[i]]<<'\n';
}
