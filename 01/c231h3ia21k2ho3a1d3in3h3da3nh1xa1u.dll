#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=3e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i)) 
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,q,a[N],d[N];
struct Node{
    int cnt;
    Node *child[2];
    Node(){
        cnt=0;
        child[0]=child[1]=NULL;
    }
}*root=new Node();
void ins(int x){
    Node *p=root;
    for(int i=18;i>=0;i--){
        int c=(x>>i)&1;
        if(p->child[c]==NULL) p->child[c]=new Node();
        p=p->child[c];
        p->cnt++;
    }
}
int get(int mask){
    Node *p=root;
    int res=0;
    for(int i=18;i>=0;i--){
        int c=(mask>>i)&1;
        if(p->child[c]&&p->child[c]->cnt==(1<<i)){
            p=p->child[c^1];
            res+=(1<<i);
        }
        else{
            if(p->child[c]) p=p->child[c];
            else return res;
        }
        if(p==NULL) return res;
    }
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n>>q;
    for(int i=1;i<=n;i++){
        cin>>a[i];
        if(!d[a[i]]){
            ins(a[i]);
            d[a[i]]++;
        }
    }
    int mask=0;
    while(q--){
        int x;
        cin>>x;
        mask^=x;
        cout<<get(mask)<<'\n';  
    }
}
