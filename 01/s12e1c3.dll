#include <bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int, int>
#define iii pair<int, pair<int, int>>
#define all(x) x.begin(), x.end()
#define fi first
#define se second
const int inf = 1e18;
const int N = 2e5 + 5;
const int mod = 1e9 + 7;
const int base = 311;
#define On(mask, i) (mask | (1LL << i))
#define Off(mask, i) (mask ^ (1LL << i))
inline int mul(int a, int b)
{
    return (a % mod) * (b % mod) % mod;
}
inline int sub(int a, int b)
{
    return ((a - b) % mod + mod) % mod;
}
inline int add(int a, int b)
{
    return (a % mod + b % mod) % mod;
}
struct Node
{
    int cnt, f;
    Node *child[2];
    Node()
    {
        for (int i = 0; i < 2; i++)
            child[i] = NULL;
        cnt = 0;
        f = 0;
    }
} *root;
void dfs(Node *p)
{
    for (int i = 0; i <= 1; i++)
    {
        if (p->child[i] != NULL)
        {
            dfs(p->child[i]);
            p->f = p->f + p->child[i]->f;
        }
    }
    p->f += p->cnt;
}
void ins(string s)
{
    Node *p = root;
    for (int x : s)
    {
        if (p->child[x - '0'] == NULL)
            p->child[x - '0'] = new Node();
        p = p->child[x - '0'];
    }
    p->cnt++;
}
int n, m, x;
char c;
main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);
    cin >> m >> n;
    root = new Node();
    for (int i = 1; i <= m; i++)
    {
        cin >> x;
        string s;
        while (x--)
        {
            cin >> c;
            s.pb(c);
        }
        ins(s);
    }
    dfs(root);
    for (int i = 1; i <= n; i++)
    {
        cin >> x;
        Node *p = root;
        int ans = 0;
        int j;
        for (j = 1; j <= x; j++)
        {
            cin >> c;
            if (p->child[c - '0'])
            {
                p = p->child[c - '0'];
                ans += (j < x ? p->cnt : p->f);
            }
            else
            {
                for (int k = j + 1; k <= x; k++)
                {
                    cin >> c;
                }
                break;
            }
        }
        cout << ans << '\n';
    }
}
