#include<bits/stdc++.h>
using namespace std;
#define ll long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define debug(x) cout<< #x << " = "<< x <<'\n'
#define Task "a"
#define ii pair<int,int>
#define iii pair<int,ii>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const ll inf=1e18;
const ll N=2e5+5;
const ll mod=1e9+7;
const ll base=311;
const ll phainon=33550336;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask&~(1LL<<i))
inline ll add(ll a,ll b){
    ll res=a+b;
    if(res>=mod) res-=mod;
    return res;
}
ll sub(ll a,ll b){
    return ((a-b)%mod+mod)%mod;
}
inline ll mul(ll a,ll b){
    ll res=a*b;
    if(res>=mod) res%=mod;
    return res;
}
int dist[5005][5005];
int n,a[N],c1,c2,c0;
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    if (fopen(Task ".inp","r")) {
        freopen(Task ".inp","r", stdin);
        freopen(Task ".out","w", stdout);
    }
    cin>>n;
    for(int i=1;i<=n;i++){
        cin>>a[i];
        if(a[i]%3==0) c0++;
        else if(a[i]%3==1) c1++;
        else c2++;
    }
    for(int i=0;i<=5000;i++){
        for(int j=0;j<=5000;j++){
            dist[i][j]=1e9;
        }
    }
    dist[c1][c2]=0;
    queue<ii>q;
    q.push({c1,c2});
    while(q.size()){
        auto [u1,u2]=q.front(); q.pop();
        int u0=n-u1-u2;
        if(u1==0&&u2==0){
            return cout<<dist[0][0],0;
        }
        for(int k0=0;k0<=3;k0++){
            for(int k1=0;k1<=3-k0;k1++){
                int k2=3-k1-k2;
                int v1=u1-k1+k2;
                int v2=u2-k2+k0;
                if(dist[v1][v2]>dist[u1][u2]+1){
                    dist[v1][v2]=dist[u1][u2]+1;
                    q.push({v1,v2});
                }
            }
        }
    }
    cout<< -1;
}
// a' du` anh beo gay a`
