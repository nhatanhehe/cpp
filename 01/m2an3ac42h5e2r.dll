vector<int> manacher(const string &ss) {
    string s = "#";
    for (char c : ss) {
        s += c;
        s += '#';
    }
    int n = s.size();
    vector<int> d(n, 0);

    int l = 0, r = -1;
    for (int i = 0; i < n; i++) {
        int k = (i > r) ? 1 : min(d[l + r - i], r - i + 1);
        while (i - k >= 0 && i + k < n && s[i - k] == s[i + k]) k++;
        d[i] = k;
        if (i + k - 1 > r) {
            l = i - k + 1;
            r = i + k - 1;
        }
    }
    return d;
}
