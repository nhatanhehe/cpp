#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i))
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return (a%mod+b%mod)%mod;
}
int n,u,v,cen[N],sz[N];
vector<int>g[N];
int dfs(int u,int p){
    sz[u]=1;
    for(int v:g[u]){
        if(v!=p&&!cen[v]){
            sz[u]+=sz[v];
        }
    }
    return sz[u];
}
int find_centroid(int u,int p,int tree_sz){
    for(int v:g[u]){
        if(v!=p&&!cen[v]&&sz[v]>tree_sz/2) return find_centroid(v,u,tree_sz);
    }
    return u;
}
vector<ii>d_in,d_glo;
void dfs2(int u,int p,int h){
    d_in.pb({u,h});
    d_glo.pb({u,h});
    for(int v:g[u]) if(v!=p&&!cen[v]) dfs2(v,u,h+1);
}
int ans[N];
void calc(vector<ii>p,int neg){
    int sz=0,sum=0;
    for(ii x:p) sz++,sum+=x.se;
    for(ii x:p){
        int dist,v;
        tie(v,dist)=x;
        ans[v]+=(dist*(sz-1)+sum-dist)*neg;
    }
}
void build(int u){
    dfs(u,-1);
    int centroid=find_centroid(u,-1,sz[u]);
    cen[centroid]=1;
    d_glo.pb({centroid,0});
    for(int v:g[centroid]){
        if(!cen[v]){
            dfs2(v,-1,1);
            calc(d_in,-1);
            d_in.clear();
        }
    }
    calc(d_glo,1);
    d_glo.clear();
    for(int v:g[centroid]){
        if(!cen[v]) build(v);
    }
}
main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);cout.tie(NULL);
    cin>>n;
    for(int i=1;i<n;i++){
        cin>>u>>v;
        g[u].pb(v);
        g[v].pb(u);
    }
    build(1);
    for(int i=1;i<=n;i++) cout<<ans[i]<<'\n';
}
