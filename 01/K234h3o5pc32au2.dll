#include<bits/stdc++.h>
using namespace std;
#define int long long
typedef long double ld;
#define pb push_back
#define pf push_front
#define ii pair<int,int>
#define iii pair<int,pair<int,int>>
#define all(x) x.begin(),x.end()
#define fi first
#define se second
const int inf=1e18;
const int N=2e5+5;
const int mod=1e9+7;
const int base=311;
#define On(mask,i) (mask|(1LL<<i))
#define Off(mask,i) (mask^(1LL<<i))
inline int mul(int a,int b){
    return (a%mod)*(b%mod)%mod;
}
inline int sub(int a,int b){
    return ((a-b)%mod+mod)%mod;
}
inline int add(int a,int b){
    return ((a%mod+b%mod)%mod+mod)%mod;
}
int n,m,u,v,scc[N],cau,khop,num[N],low[N],vis[N],cnt,tplt;
vector<ii>g[N],bridges;
stack<int>s;
vector<int>points;
ii edges[N];
void tarjan(int u,int id){
    low[u]=num[u]=++cnt;
    s.push(u);
    int vung=(id!=-1);
    for(auto [v,nw_id]:g[u]){
        if(nw_id!=id){
            if(!vis[v]){
                if(num[v]) low[u]=min(low[u],num[v]);
                else{
                    tarjan(v,nw_id),low[u]=min(low[u],low[v]);
                    if(low[v]>=num[u]) vung++;
                }
            }
        }
    }
    if(vung>1) points.pb(u);
    if(low[u]==num[u]){
        tplt++;
        int v;
        do{
            v=s.top(); s.pop();
            scc[v]=tplt; vis[v]=1;
        }while(u!=v);
    }
}
main(){
    //name cut
     ios_base::sync_with_stdio(false);
     cin.tie(NULL);
       cout.tie(NULL);
if(fopen("cut.inp","r")){
     freopen("cut.inp","r",stdin);
     freopen("cut.out","w",stdout);
}
    cin>>n>>m;
    for(int i=1;i<=m;i++){
        cin>>u>>v;
        g[u].pb({v,i});
        g[v].pb({u,i});
        edges[i]={u,v};
    }
    for(int i=1;i<=n;i++){
        if(!vis[i]) tarjan(i,-1);
    }
    for(int i=1;i<=m;i++){
        auto [u,v]=edges[i];
        if(scc[v]!=scc[u]){
            bridges.pb({u,v});
        }
    }
    cout<<bridges.size()<<" "<<points.size()<<'\n';
    for(auto [u,v]:bridges) cout<<u<<" "<<v<<'\n';
    for(int x:points) cout<<x<<'\n';
}
